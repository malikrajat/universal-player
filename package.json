    "rxjs": "^7.8.2",
    "svelte": "^5.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3",
    "vite-plus": "^1.4.0",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
