  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/entries/index.js",
    "./dist/entries/ui.js"
  ],
  "main": "./dist/entries/index.js",
  "module": "./dist/entries/index.js",
  "types": "./dist/entries/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.js"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./ui": {
      "types": "./dist/entries/ui.d.ts",
      "import": "./dist/entries/ui.js"
    },
    "./vanilla": {
      "types": "./dist/entries/vanilla.d.ts",
      "import": "./dist/entries/vanilla.js"
    },
    "./react": {
      "types": "./dist/entries/react.d.ts",
      "import": "./dist/entries/react.js"
    },
    "./vue": {
      "types": "./dist/entries/vue.d.ts",
      "import": "./dist/entries/vue.js"
    },
    "./angular": {
      "types": "./dist/entries/angular.d.ts",
      "import": "./dist/entries/angular.js"
    },
    "./svelte4": {
      "types": "./dist/frameworks/svelte4/UniversalPlayer.svelte.d.ts",
      "svelte": "./dist/frameworks/svelte4/UniversalPlayer.svelte",
      "default": "./dist/frameworks/svelte4/UniversalPlayer.svelte"
    },
    "./svelte5": {
      "types": "./dist/frameworks/svelte5/UniversalPlayer.svelte.d.ts",
      "svelte": "./dist/frameworks/svelte5/UniversalPlayer.svelte",
      "default": "./dist/frameworks/svelte5/UniversalPlayer.svelte"
    },
    "./styles.css": "./dist/ui/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:repo": "pnpm run build && node scripts/create-repo-folder.mjs --force",
    "repo": "node scripts/create-repo-folder.mjs",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test --coverage",
    "test:browser": "vp test --config vitest.browser.config.ts",
    "docs": "typedoc",
    "check:pack": "node scripts/check-pack-contents.mjs",
    "check:imports": "node scripts/check-browser-imports.mjs",
    "check:exports": "publint --strict",
    "check:types": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./svelte4 ./svelte5",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:pack && pnpm run check:imports && pnpm run check:exports && pnpm run check:types",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "sbom": "pnpm sbom --sbom-format cyclonedx --sbom-type library --sbom-authors \"Rajat Malik\" > sbom.json"
  },
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.0",
